{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pakperk.invalid/schemas/deep-reader/corpus-manifest-v1.schema.json",
  "title": "Pakperk Deep Reader repository corpus manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "purpose",
    "classification",
    "rights_review_status",
    "human_ground_truth_status",
    "required_document_classes",
    "documents",
    "thresholds",
    "protected_evidence"
  ],
  "properties": {
    "schema_version": {"const": "deep-reader-evaluation-v1"},
    "corpus_id": {"$ref": "common-v1.schema.json#/$defs/safeId"},
    "purpose": {"const": "contract_validation_only_not_representative_benchmark"},
    "classification": {"const": "repository_synthetic_contract_fixture"},
    "rights_review_status": {"const": "not_ready"},
    "human_ground_truth_status": {"const": "not_ready"},
    "required_document_classes": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "prefixItems": [
        {"const": "two_column"},
        {"const": "nested_sections"},
        {"const": "equation_heavy"},
        {"const": "dense_tables"},
        {"const": "multi_panel_figures"},
        {"const": "malformed_references"},
        {"const": "scanned_or_image_heavy"},
        {"const": "long_appendix"},
        {"const": "unusual_headings"},
        {"const": "older_arxiv"}
      ],
      "items": false
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/document"}
    },
    "thresholds": {"$ref": "#/$defs/thresholds"},
    "protected_evidence": {
      "$ref": "common-v1.schema.json#/$defs/protectedEvidence"
    }
  },
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_id",
        "source_kind",
        "source_path",
        "source_sha256",
        "document_classes",
        "label_set_id",
        "allowed_adapters"
      ],
      "properties": {
        "fixture_id": {"$ref": "common-v1.schema.json#/$defs/safeId"},
        "source_kind": {"const": "synthetic"},
        "source_path": {"type": "string", "minLength": 1, "maxLength": 512},
        "source_sha256": {"$ref": "common-v1.schema.json#/$defs/sha256"},
        "document_classes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "common-v1.schema.json#/$defs/safeId"}
        },
        "label_set_id": {"$ref": "common-v1.schema.json#/$defs/safeId"},
        "allowed_adapters": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["grobid", "docling-experimental"]}
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parser", "passport", "assistant", "visual"],
      "properties": {
        "parser": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min_block_precision_basis_points",
            "min_block_recall_basis_points",
            "min_block_order_basis_points",
            "min_paragraph_boundary_precision_basis_points",
            "min_paragraph_boundary_recall_basis_points",
            "min_section_path_basis_points",
            "min_introduction_precision_basis_points",
            "min_introduction_recall_basis_points",
            "min_citation_precision_basis_points",
            "min_citation_recall_basis_points",
            "min_visual_precision_basis_points",
            "min_visual_recall_basis_points",
            "min_page_mapping_basis_points",
            "min_source_navigation_basis_points",
            "max_replacement_characters_per_million",
            "max_duplicate_content_hash_count",
            "max_missing_labeled_block_count",
            "max_optional_latency_ratio_basis_points",
            "max_optional_memory_ratio_basis_points"
          ],
          "properties": {
            "min_block_precision_basis_points": {"$ref": "common-v1.schema.json#/$defs/basisPoints"},
            "min_block_recall_basis_points": {"$ref": "common-v1.schema.json#/$defs/basisPoints"},
            "min_block_order_basis_points": {"$ref": "common-v1.schema.json#/$defs/basisPoints"},
            "min_paragraph_boundary_precision_basis_points": {"$ref": "common-v1.schema.json#/$defs/basisPoints"},
            "min_paragraph_boundary_recall_basis_points": {"$ref": "common-v1.schema.json#/$defs/basisPoints"},
            "min_section_path_basis_points": {"$ref": "common-v1.schema.json#/$defs/basisPoints"},
            "min_introduction_precision_basis_points": {"$ref": "common-v1.schema.json#/$defs/basisPoints"},
            "min_introduction_recall_basis_points": {"$ref": "common-v1.schema.json#/$defs/basisPoints"},
            "min_citation_precision_basis_points": {"$ref": "common-v1.schema.json#/$defs/basisPoints"},
            "min_citation_recall_basis_points": {"$ref": "common-v1.schema.json#/$defs/basisPoints"},
            "min_visual_precision_basis_points": {"$ref": "common-v1.schema.json#/$defs/basisPoints"},
            "min_visual_recall_basis_points": {"$ref": "common-v1.schema.json#/$defs/basisPoints"},
            "min_page_mapping_basis_points": {"$ref": "common-v1.schema.json#/$defs/basisPoints"},
            "min_source_navigation_basis_points": {"$ref": "common-v1.schema.json#/$defs/basisPoints"},
            "max_replacement_characters_per_million": {"type": "integer", "minimum": 0, "maximum": 1000000},
            "max_duplicate_content_hash_count": {"type": "integer", "minimum": 0, "maximum": 100000},
            "max_missing_labeled_block_count": {"type": "integer", "minimum": 0, "maximum": 100000},
            "max_optional_latency_ratio_basis_points": {"type": "integer", "minimum": 0, "maximum": 100000},
            "max_optional_memory_ratio_basis_points": {"type": "integer", "minimum": 0, "maximum": 100000}
          }
        },
        "passport": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min_evidence_precision_basis_points",
            "min_missing_field_abstention_basis_points",
            "min_status_accuracy_basis_points"
          ],
          "properties": {
            "min_evidence_precision_basis_points": {"$ref": "common-v1.schema.json#/$defs/basisPoints"},
            "min_missing_field_abstention_basis_points": {"$ref": "common-v1.schema.json#/$defs/basisPoints"},
            "min_status_accuracy_basis_points": {"$ref": "common-v1.schema.json#/$defs/basisPoints"}
          }
        },
        "assistant": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_invented_evidence_ids",
            "max_unsupported_citation_basis_points",
            "min_method_detail_baseline_basis_points"
          ],
          "properties": {
            "max_invented_evidence_ids": {"type": "integer", "minimum": 0, "maximum": 100000},
            "max_unsupported_citation_basis_points": {"$ref": "common-v1.schema.json#/$defs/basisPoints"},
            "min_method_detail_baseline_basis_points": {"$ref": "common-v1.schema.json#/$defs/basisPoints"}
          }
        },
        "visual": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min_object_precision_basis_points",
            "min_object_recall_basis_points",
            "min_table_structure_basis_points",
            "min_source_navigation_basis_points"
          ],
          "properties": {
            "min_object_precision_basis_points": {"$ref": "common-v1.schema.json#/$defs/basisPoints"},
            "min_object_recall_basis_points": {"$ref": "common-v1.schema.json#/$defs/basisPoints"},
            "min_table_structure_basis_points": {"$ref": "common-v1.schema.json#/$defs/basisPoints"},
            "min_source_navigation_basis_points": {"$ref": "common-v1.schema.json#/$defs/basisPoints"}
          }
        }
      }
    }
  }
}
