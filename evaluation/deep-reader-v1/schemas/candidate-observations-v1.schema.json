{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pakperk.invalid/schemas/deep-reader/candidate-observations-v1.schema.json",
  "title": "Pakperk Deep Reader synthetic candidate observations v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "scope",
    "measurement_kind",
    "parser_runs",
    "passport_predictions",
    "assistant_predictions",
    "visual_predictions",
    "protected_evidence"
  ],
  "properties": {
    "schema_version": {"const": "deep-reader-evaluation-v1"},
    "candidate_id": {"$ref": "common-v1.schema.json#/$defs/safeId"},
    "scope": {"const": "synthetic_repository_fixture"},
    "measurement_kind": {"const": "synthetic"},
    "parser_runs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {"$ref": "#/$defs/parserRun"}
    },
    "passport_predictions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/passportPrediction"}
    },
    "assistant_predictions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/assistantPrediction"}
    },
    "visual_predictions": {
      "type": "array",
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/visualPrediction"}
    },
    "protected_evidence": {
      "$ref": "common-v1.schema.json#/$defs/protectedEvidence"
    }
  },
  "$defs": {
    "parserRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_id",
        "adapter_id",
        "adapter_version",
        "status",
        "blocks",
        "citations",
        "visual_objects",
        "resource",
        "failure_class",
        "fallback_action"
      ],
      "properties": {
        "fixture_id": {"$ref": "common-v1.schema.json#/$defs/safeId"},
        "adapter_id": {"enum": ["grobid", "docling-experimental"]},
        "adapter_version": {"$ref": "common-v1.schema.json#/$defs/safeId"},
        "status": {"enum": ["succeeded", "failed", "adapter_disabled"]},
        "blocks": {
          "type": "array",
          "maxItems": 1024,
          "items": {"$ref": "#/$defs/parserBlock"}
        },
        "citations": {
          "type": "array",
          "maxItems": 1024,
          "items": {"$ref": "#/$defs/citation"}
        },
        "visual_objects": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/parserVisual"}
        },
        "resource": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["wall_time_ms", "peak_rss_bytes"],
              "properties": {
                "wall_time_ms": {"type": "integer", "minimum": 1, "maximum": 86400000},
                "peak_rss_bytes": {"type": "integer", "minimum": 1, "maximum": 1125899906842624}
              }
            }
          ]
        },
        "failure_class": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "common-v1.schema.json#/$defs/safeId"}
          ]
        },
        "fallback_action": {"enum": ["none", "use_grobid", "metadata_only"]}
      }
    },
    "parserBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id",
        "kind",
        "section_path",
        "is_introduction",
        "page",
        "source_locator_present",
        "content_sha256",
        "text_scalar_count",
        "replacement_character_count"
      ],
      "properties": {
        "block_id": {"$ref": "common-v1.schema.json#/$defs/safeId"},
        "kind": {"$ref": "common-v1.schema.json#/$defs/blockKind"},
        "section_path": {"$ref": "common-v1.schema.json#/$defs/idList"},
        "is_introduction": {"type": "boolean"},
        "page": {"type": ["integer", "null"], "minimum": 1, "maximum": 100000},
        "source_locator_present": {"type": "boolean"},
        "content_sha256": {"$ref": "common-v1.schema.json#/$defs/sha256"},
        "text_scalar_count": {"type": "integer", "minimum": 0, "maximum": 10000000},
        "replacement_character_count": {"type": "integer", "minimum": 0, "maximum": 10000000}
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mention_id", "source_block_id", "target_id"],
      "properties": {
        "mention_id": {"$ref": "common-v1.schema.json#/$defs/safeId"},
        "source_block_id": {"$ref": "common-v1.schema.json#/$defs/safeId"},
        "target_id": {"$ref": "common-v1.schema.json#/$defs/safeId"}
      }
    },
    "parserVisual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "kind", "caption_id", "structure_sha256"],
      "properties": {
        "object_id": {"$ref": "common-v1.schema.json#/$defs/safeId"},
        "kind": {"$ref": "common-v1.schema.json#/$defs/visualKind"},
        "caption_id": {"$ref": "common-v1.schema.json#/$defs/safeId"},
        "structure_sha256": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "common-v1.schema.json#/$defs/sha256"}
          ]
        }
      }
    },
    "passportPrediction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_id", "field_key", "predicted_status", "evidence_block_ids"],
      "properties": {
        "fixture_id": {"$ref": "common-v1.schema.json#/$defs/safeId"},
        "field_key": {
          "enum": [
            "research_question",
            "contribution",
            "method",
            "data_or_sample",
            "evaluation",
            "main_result",
            "limitations",
            "assumptions_scope",
            "code_resources",
            "publication_status"
          ]
        },
        "predicted_status": {"$ref": "common-v1.schema.json#/$defs/passportStatus"},
        "evidence_block_ids": {"$ref": "common-v1.schema.json#/$defs/idList"}
      }
    },
    "assistantPrediction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_id", "case_id", "status", "claims", "latency_ms", "cost_microusd"],
      "properties": {
        "fixture_id": {"$ref": "common-v1.schema.json#/$defs/safeId"},
        "case_id": {"$ref": "common-v1.schema.json#/$defs/safeId"},
        "status": {"$ref": "common-v1.schema.json#/$defs/assistantStatus"},
        "claims": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim_id", "support", "evidence_block_ids"],
            "properties": {
              "claim_id": {"$ref": "common-v1.schema.json#/$defs/safeId"},
              "support": {"enum": ["direct", "inferred"]},
              "evidence_block_ids": {
                "allOf": [
                  {"$ref": "common-v1.schema.json#/$defs/idList"},
                  {"minItems": 1, "maxItems": 128}
                ]
              }
            }
          }
        },
        "latency_ms": {"type": "integer", "minimum": 0, "maximum": 86400000},
        "cost_microusd": {"type": "integer", "minimum": 0, "maximum": 1000000000000}
      }
    },
    "visualPrediction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_id", "object_id", "kind", "caption_id", "structure_sha256", "source_navigation"],
      "properties": {
        "fixture_id": {"$ref": "common-v1.schema.json#/$defs/safeId"},
        "object_id": {"$ref": "common-v1.schema.json#/$defs/safeId"},
        "kind": {"$ref": "common-v1.schema.json#/$defs/visualKind"},
        "caption_id": {"$ref": "common-v1.schema.json#/$defs/safeId"},
        "structure_sha256": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "common-v1.schema.json#/$defs/sha256"}
          ]
        },
        "source_navigation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["page", "source_block_ids", "original_locator_present"],
          "properties": {
            "page": {"type": ["integer", "null"], "minimum": 1, "maximum": 100000},
            "source_block_ids": {"$ref": "common-v1.schema.json#/$defs/idList"},
            "original_locator_present": {"type": "boolean"}
          }
        }
      }
    }
  }
}
