#include "Release.xcconfig"
// Release builds never fall back to automatic/personal-team signing.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Apple Distribution
#include? "LocalSigning.xcconfig"
PAKPERK_BUNDLE_IDENTIFIER = app.pakperk.pakperk.dev
PAKPERK_DISPLAY_NAME = PakPerk Dev
PAKPERK_AUTH_CALLBACK_SCHEME = pakperk-auth-dev
PAKPERK_APP_LINK_HOST = localhost
PAKPERK_INFO_PLIST = Runner/Info-Dev.plist
PAKPERK_ENTITLEMENTS_FILE = Runner/RunnerDev.entitlements
DEVELOPMENT_TEAM = $(PAKPERK_DEVELOPMENT_TEAM)
