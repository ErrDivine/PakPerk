<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Defense in depth for OEM/device-transfer implementations. Secure
         session material and account-owned state never leave this device. -->
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
