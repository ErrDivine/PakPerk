{
  "openapi": "3.1.0",
  "info": {
    "title": "Pakperk API",
    "description": "Stable v1 paper-reading API. Account, library, and comment routes are intentionally absent until their production phases are complete.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "1.0.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "routes::health"
        ],
        "operationId": "health_live",
        "responses": {
          "200": {
            "description": "Process is live",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseSchema"
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "routes::health"
        ],
        "operationId": "health_ready",
        "responses": {
          "200": {
            "description": "Database is ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseSchema"
                },
                "example": {
                  "status": "ready"
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeSchema"
                }
              }
            }
          }
        }
      }
    },
    "/v1/feed": {
      "get": {
        "tags": [
          "routes::feed"
        ],
        "operationId": "feed",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "description": "arXiv category",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque page cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Page size",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "Entity tag returned by an earlier response for the same feed query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paper summary page",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "Public chronological-feed cache policy"
              },
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "Opaque validator for this feed query and representation"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedPageSchema"
                }
              }
            }
          },
          "304": {
            "description": "Feed representation has not changed; response body is empty",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "Public chronological-feed cache policy"
              },
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "Current opaque feed validator"
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeSchema"
                }
              }
            }
          }
        }
      }
    },
    "/v1/papers/by-arxiv/{arxiv_id}": {
      "get": {
        "tags": [
          "routes::papers"
        ],
        "operationId": "paper_by_arxiv",
        "parameters": [
          {
            "name": "arxiv_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paper metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaperSummarySchema"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arXiv identifier",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeSchema"
                }
              }
            }
          },
          "404": {
            "description": "Paper not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeSchema"
                }
              }
            }
          }
        }
      }
    },
    "/v1/papers/{paper_id}": {
      "get": {
        "tags": [
          "routes::papers"
        ],
        "operationId": "paper_metadata",
        "parameters": [
          {
            "name": "paper_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paper metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaperSummarySchema"
                }
              }
            }
          },
          "404": {
            "description": "Paper not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeSchema"
                }
              }
            }
          }
        }
      }
    },
    "/v1/papers/{paper_id}/chat": {
      "post": {
        "tags": [
          "routes::chat"
        ],
        "operationId": "chat",
        "parameters": [
          {
            "name": "paper_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Grounded chat answer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponseSchema"
                }
              }
            }
          },
          "400": {
            "description": "Invalid anonymous session or question",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeSchema"
                }
              }
            }
          },
          "403": {
            "description": "Full-text policy denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeSchema"
                }
              }
            }
          },
          "409": {
            "description": "Capability not ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeSchema"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeSchema"
                }
              }
            }
          }
        }
      }
    },
    "/v1/papers/{paper_id}/connections": {
      "get": {
        "tags": [
          "routes::papers"
        ],
        "operationId": "connections",
        "parameters": [
          {
            "name": "paper_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paper connections",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionsResponseSchema"
                }
              }
            }
          },
          "403": {
            "description": "Full-text policy denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeSchema"
                }
              }
            }
          },
          "404": {
            "description": "Paper not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeSchema"
                }
              }
            }
          },
          "409": {
            "description": "Capability not ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeSchema"
                }
              }
            }
          }
        }
      }
    },
    "/v1/papers/{paper_id}/introduction": {
      "get": {
        "tags": [
          "routes::papers"
        ],
        "operationId": "introduction",
        "parameters": [
          {
            "name": "paper_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paper introduction",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntroductionSchema"
                }
              }
            }
          },
          "403": {
            "description": "Full-text policy denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeSchema"
                }
              }
            }
          },
          "404": {
            "description": "Paper not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeSchema"
                }
              }
            }
          },
          "409": {
            "description": "Capability not ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeSchema"
                }
              }
            }
          }
        }
      }
    },
    "/v1/papers/{paper_id}/prepare": {
      "post": {
        "tags": [
          "routes::papers"
        ],
        "operationId": "prepare",
        "parameters": [
          {
            "name": "paper_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PrepareBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Already ready or terminal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcessingStateSchema"
                }
              }
            }
          },
          "202": {
            "description": "Preparation accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcessingStateSchema"
                }
              }
            }
          },
          "404": {
            "description": "Paper not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeSchema"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeSchema"
                }
              }
            }
          }
        }
      }
    },
    "/v1/papers/{paper_id}/processing": {
      "get": {
        "tags": [
          "routes::papers"
        ],
        "operationId": "processing",
        "parameters": [
          {
            "name": "paper_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Processing state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcessingStateSchema"
                }
              }
            }
          },
          "404": {
            "description": "Paper not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeSchema"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CapabilitiesSchema": {
        "type": "object",
        "required": [
          "metadata",
          "introduction",
          "chat",
          "connections"
        ],
        "properties": {
          "chat": {
            "type": "boolean"
          },
          "connections": {
            "type": "boolean"
          },
          "introduction": {
            "type": "boolean"
          },
          "metadata": {
            "type": "boolean"
          }
        }
      },
      "ChatBody": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "thread_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      },
      "ChatEvidenceSchema": {
        "type": "object",
        "required": [
          "section_kind",
          "chunk_id"
        ],
        "properties": {
          "chunk_id": {
            "type": "string",
            "format": "uuid"
          },
          "page_end": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "page_start": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "section_heading": {
            "type": [
              "string",
              "null"
            ]
          },
          "section_kind": {
            "$ref": "#/components/schemas/SectionKindSchema"
          }
        }
      },
      "ChatResponseSchema": {
        "type": "object",
        "required": [
          "thread_id",
          "generation",
          "answer_markdown",
          "insufficient_evidence",
          "evidence",
          "suggested_follow_ups",
          "prompt_version"
        ],
        "properties": {
          "answer_markdown": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatEvidenceSchema"
            }
          },
          "generation": {
            "type": "integer",
            "format": "int32"
          },
          "insufficient_evidence": {
            "type": "boolean"
          },
          "model_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "prompt_version": {
            "type": "string"
          },
          "provider_request_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "suggested_follow_ups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "thread_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ConnectionReferenceSchema": {
        "type": "object",
        "required": [
          "ordinal",
          "raw_text",
          "resolved",
          "resolution_status"
        ],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "paper_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "raw_text": {
            "type": "string"
          },
          "resolution_status": {
            "$ref": "#/components/schemas/ReferenceResolutionStatusSchema"
          },
          "resolved": {
            "type": "boolean"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ConnectionsResponseSchema": {
        "type": "object",
        "required": [
          "paper_id",
          "generation",
          "ready",
          "key_connections",
          "references"
        ],
        "properties": {
          "generation": {
            "type": "integer",
            "format": "int32"
          },
          "key_connections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/KeyConnectionSchema"
            }
          },
          "paper_id": {
            "type": "string",
            "format": "uuid"
          },
          "ready": {
            "type": "boolean"
          },
          "references": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConnectionReferenceSchema"
            }
          }
        }
      },
      "ErrorBodySchema": {
        "type": "object",
        "required": [
          "code",
          "message",
          "retryable",
          "request_id"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable error code.",
            "example": "PAPER_NOT_FOUND"
          },
          "message": {
            "type": "string",
            "example": "The requested paper was not found."
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "retryable": {
            "type": "boolean"
          }
        }
      },
      "ErrorEnvelopeSchema": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBodySchema"
          }
        }
      },
      "FailureCategorySchema": {
        "type": "string",
        "enum": [
          "external_temporary",
          "external_permanent",
          "parser_temporary",
          "parser_document",
          "model_temporary",
          "validation",
          "internal"
        ]
      },
      "FeedPageSchema": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PaperSummarySchema"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "HealthResponseSchema": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        }
      },
      "IntroductionCitationReferenceSchema": {
        "type": "object",
        "required": [
          "paper_id",
          "title"
        ],
        "properties": {
          "paper_id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "IntroductionCitationSchema": {
        "type": "object",
        "required": [
          "start",
          "end",
          "marker",
          "references"
        ],
        "properties": {
          "end": {
            "type": "integer",
            "minimum": 0
          },
          "marker": {
            "type": "string"
          },
          "references": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IntroductionCitationReferenceSchema"
            }
          },
          "start": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "IntroductionDetectionSchema": {
        "type": "object",
        "required": [
          "confidence",
          "used_fallback"
        ],
        "properties": {
          "confidence": {
            "type": "number",
            "format": "float"
          },
          "used_fallback": {
            "type": "boolean"
          }
        }
      },
      "IntroductionParagraphSchema": {
        "type": "object",
        "required": [
          "ordinal",
          "text",
          "citations"
        ],
        "properties": {
          "citations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IntroductionCitationSchema"
            }
          },
          "heading": {
            "type": [
              "string",
              "null"
            ]
          },
          "ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "page_end": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "page_start": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "text": {
            "type": "string"
          }
        }
      },
      "IntroductionSchema": {
        "type": "object",
        "required": [
          "paper_id",
          "generation",
          "paragraphs",
          "detection",
          "original_pdf_url"
        ],
        "properties": {
          "detection": {
            "$ref": "#/components/schemas/IntroductionDetectionSchema"
          },
          "generation": {
            "type": "integer",
            "format": "int32"
          },
          "heading": {
            "type": [
              "string",
              "null"
            ]
          },
          "original_pdf_url": {
            "type": "string"
          },
          "paper_id": {
            "type": "string",
            "format": "uuid"
          },
          "paragraphs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IntroductionParagraphSchema"
            }
          }
        }
      },
      "KeyConnectionSchema": {
        "type": "object",
        "required": [
          "reference_id",
          "paper_id",
          "arxiv_id",
          "title",
          "authors",
          "relation_type",
          "summary",
          "confidence"
        ],
        "properties": {
          "arxiv_id": {
            "type": "string"
          },
          "authors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "format": "float"
          },
          "paper_id": {
            "type": "string",
            "format": "uuid"
          },
          "reference_id": {
            "type": "string",
            "format": "uuid"
          },
          "relation_type": {
            "$ref": "#/components/schemas/RelationTypeSchema"
          },
          "summary": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "year": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          }
        }
      },
      "OverallProcessingStateSchema": {
        "type": "string",
        "enum": [
          "not_requested",
          "processing",
          "ready",
          "failed"
        ]
      },
      "PaperSummarySchema": {
        "type": "object",
        "required": [
          "paper_id",
          "arxiv_id",
          "title",
          "abstract",
          "authors",
          "primary_category",
          "categories",
          "published_at",
          "updated_at",
          "abs_url",
          "pdf_url",
          "capabilities"
        ],
        "properties": {
          "abs_url": {
            "type": "string"
          },
          "abstract": {
            "type": "string"
          },
          "arxiv_id": {
            "type": "string",
            "example": "2401.12345v2"
          },
          "authors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "capabilities": {
            "$ref": "#/components/schemas/CapabilitiesSchema"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "paper_id": {
            "type": "string",
            "format": "uuid"
          },
          "pdf_url": {
            "type": "string"
          },
          "primary_category": {
            "type": "string"
          },
          "published_at": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
