APP_ENV=development
# Production capabilities remain independently fail-closed. Enable them only
# after the matching deployment, policy, and operational gates have evidence.
ACCOUNTS_ENABLED=false
LIBRARY_ENABLED=false
# Emergency read-only switch. It may be true only while the library is
# enabled; disabling it keeps list/change reads and rejects save/remove.
LIBRARY_WRITES_ENABLED=false
# Shared per-user library write budget. Read routes are not charged.
LIBRARY_MUTATION_LIMIT=120
LIBRARY_MUTATION_WINDOW_SECONDS=3600
COMMENTS_ENABLED=false
# Emergency publication switch. When false, only POST comment creation is
# rejected; reads and every safety/moderation action stay available.
COMMENT_CREATION_ENABLED=false
# These values are deployment assertions for the fixed v0.0 domain policy;
# startup rejects drift from the server-enforced limits.
COMMENT_MAX_SCALARS=2000
COMMENT_MAX_BYTES=8000
COMMENT_MAX_URLS=3
COMMENT_MODERATION_PROVIDER=rules
# Required only when COMMENT_MODERATION_PROVIDER=http. Deployed environments
# require an HTTPS endpoint and an absolute owner-only token file.
# COMMENT_MODERATION_URL=https://moderation.example.invalid/v1/evaluate
# COMMENT_MODERATION_TOKEN_FILE=/run/secrets/comment-moderation-token
# COMMENT_MODERATION_TIMEOUT_MS=2000
COMMENT_SUPPORT_CONTACT_URL=https://pakperk.app/support
# Required for shared anonymous prepare/chat and comment origin limits. Mount a
# non-placeholder random secret in a regular owner-only file (0400/0600).
API_ORIGIN_HASH_SECRET_FILE=/var/run/pakperk-secrets/API_ORIGIN_HASH_SECRET
# Optional for direct development. Required outside development: comma-separated
# canonical CIDRs of ingress proxies allowed to supply X-Forwarded-For.
API_TRUSTED_PROXY_CIDRS=
COMMENT_MAXIMUM_PAGE_SIZE=50
COMMENT_CREATE_LIMIT=10
COMMENT_CREATE_WINDOW_SECONDS=3600
COMMENT_MUTATION_LIMIT=60
COMMENT_MUTATION_WINDOW_SECONDS=3600
COMMENT_REPORT_LIMIT=30
COMMENT_REPORT_WINDOW_SECONDS=3600
COMMENT_ORIGIN_LIMIT=120
COMMENT_ORIGIN_WINDOW_SECONDS=3600
ACCOUNT_DELETION_ENABLED=false
# Required only when ACCOUNTS_ENABLED=true. The reference development issuer
# is started with `docker compose --profile accounts up -d`.
OIDC_ISSUER_URL=http://localhost:8081/realms/pakperk
OIDC_AUDIENCE=pakperk-api
OIDC_ALLOWED_ALGORITHMS=RS256
OIDC_DISCOVERY_TIMEOUT_SECONDS=5
OIDC_JWKS_CACHE_TTL_SECONDS=900
OIDC_JWKS_MIN_REFRESH_SECONDS=30
OIDC_CLOCK_SKEW_SECONDS=30
# Throttle local last-seen writes and bound background OIDC rediscovery.
ACCOUNT_LAST_SEEN_INTERVAL_SECONDS=900
# Account-enabled APIs require a stable restore-safe HMAC keyring even when the
# deletion route is off. Files use key_id:base64(32..128 random bytes), active
# key first, and must be owner-only. Deployed API/worker pods mount the same
# rotation-ordered fingerprint and provider-coordinate AEAD keyrings.
ACCOUNT_IDENTITY_FINGERPRINT_KEYS_FILE=
ACCOUNT_DELETION_PROVIDER_IDENTITY_KEYS_FILE=/var/run/pakperk-secrets/ACCOUNT_DELETION_PROVIDER_IDENTITY_KEYS
# Deletion API and worker share these restore-safe settings. Key files contain
# `key_id:base64(32..128 random bytes)` entries, active key first, and must be
# owner-only regular files. The external ledger directory must also be
# owner-only and live on separately backed-up durable storage.
ACCOUNT_DELETION_LEDGER_SIGNING_KEYS_FILE=/var/run/pakperk-secrets/ACCOUNT_DELETION_LEDGER_SIGNING_KEYS
ACCOUNT_DELETION_LEDGER_DIRECTORY=/var/lib/pakperk/deletion-ledger
ACCOUNT_DELETION_LEDGER_ENVIRONMENT_ID=development
ACCOUNT_DELETION_RECENT_AUTH_SECONDS=300
ACCOUNT_DELETE_LIMIT=2
ACCOUNT_DELETE_WINDOW_SECONDS=3600
# `pakperk-admin` only. Use a dedicated operator audience, require provider
# `auth_time`, and mount a short-lived token in an owner-only non-symlink file.
# The allowlist contains local Pakperk user UUIDs, never OIDC subjects/emails.
ADMIN_OIDC_ISSUER_URL=https://identity.pakperk.app/realms/pakperk
ADMIN_OIDC_AUDIENCE=pakperk-admin
ADMIN_OIDC_ALLOWED_ALGORITHMS=RS256
ADMIN_OIDC_ALLOW_INSECURE_HTTP=false
ADMIN_AUTH_MAX_AGE_SECONDS=900
ADMIN_AUTHORIZED_USER_IDS=REJECTED_PLACEHOLDER_REPLACE_WITH_LOCAL_USER_UUIDS
PAKPERK_ADMIN_ACCESS_TOKEN_FILE=/run/secrets/pakperk-admin-access-token
ACCOUNT_DELETION_MAX_ATTEMPTS=12
ACCOUNT_SECURITY_RETENTION_DAYS=90
ACCOUNT_DELETION_LEDGER_RETENTION_DAYS=400
ACCOUNT_RECOVERABLE_BACKUP_DAYS=35
# Dedicated deletion-worker scheduling and retry controls.
ACCOUNT_DELETION_WORKER_ID=deletion-worker-dev-1
ACCOUNT_DELETION_JOB_LEASE_SECONDS=60
ACCOUNT_DELETION_STEP_TIMEOUT_SECONDS=30
ACCOUNT_DELETION_POLL_INTERVAL_MS=1000
ACCOUNT_DELETION_RETRY_BASE_SECONDS=5
ACCOUNT_DELETION_RETRY_MAX_SECONDS=3600
ACCOUNT_DELETION_CLEANUP_INTERVAL_SECONDS=3600
ACCOUNT_DELETION_CLEANUP_BATCH_SIZE=1000
ACCOUNT_DELETION_PENDING_FILE_MAX_AGE_SECONDS=3600
# Required by the deletion worker's run command. The client has only the
# Keycloak `realm-management/manage-users` service-account role; readiness
# performs a non-destructive Admin REST permission probe, not just token issue.
IDENTITY_ADMIN_PROVIDER=keycloak
KEYCLOAK_ADMIN_BASE_URL=http://localhost:8081
KEYCLOAK_REALM=pakperk
KEYCLOAK_ADMIN_CLIENT_ID=pakperk-deletion-worker-dev
KEYCLOAK_ADMIN_CLIENT_SECRET_FILE=/var/run/pakperk-secrets/KEYCLOAK_ADMIN_CLIENT_SECRET
OIDC_RETRY_INITIAL_SECONDS=5
OIDC_RETRY_MAX_SECONDS=300
CURRENT_TERMS_VERSION=2026-07-31
CURRENT_COMMUNITY_GUIDELINES_VERSION=2026-07-31
PROFILE_UPDATE_LIMIT=5
PROFILE_UPDATE_WINDOW_SECONDS=3600
API_BIND=0.0.0.0:8080
DATABASE_URL=postgres://pakperk:pakperk@postgres:5432/pakperk
DATABASE_POOL_SIZE=10
RUN_MIGRATIONS=true
# Standalone staging/production migration job assertions. Backup identifiers
# name a verified real snapshot/PITR point and are deliberately not defaulted.
PAKPERK_MIGRATION_BACKUP_ID=
PAKPERK_MIGRATION_EXPECTED_VERSION=10
# Staging/production require explicit HTTPS origins. Production also requires
# RUN_MIGRATIONS=false and FULLTEXT_POLICY=strict.
RUST_LOG=pakperk=info,tower_http=info
LOG_FORMAT=compact
REQUEST_TIMEOUT_SECONDS=30
CHAT_REQUEST_TIMEOUT_SECONDS=65
API_MAX_REQUEST_BYTES=65536
CORS_ALLOWED_ORIGINS=http://localhost:3000

ARXIV_CATEGORIES=cs.AI,cs.CL,cs.LG
ARXIV_BATCH_SIZE=100
ARXIV_MIN_INTERVAL_MS=3000
ARXIV_USER_AGENT=Pakperk/0.2.0
# Required before either Rust process starts. Use a monitored, real address;
# placeholder and example-domain contacts are rejected deliberately.
ARXIV_CONTACT_EMAIL=REJECTED_PLACEHOLDER_REPLACE_WITH_MONITORED_CONTACT
ARXIV_REQUEST_TIMEOUT_SECONDS=30
ARXIV_CACHE_TTL_SECONDS=86400
METADATA_SYNC_ON_START=false
METADATA_SYNC_INTERVAL_SECONDS=86400

GROBID_URL=http://grobid:8070
GROBID_TIMEOUT_SECONDS=180
MAX_PDF_BYTES=52428800
# Reserved for a future licensed raw-PDF cache. Current workers always use a
# bounded temporary file and delete it after parsing.
PDF_CACHE_TTL_HOURS=24
FULLTEXT_POLICY=prototype

LLM_PROVIDER=deterministic
LLM_BASE_URL=
LLM_API_KEY=
# Prefer this owner-only file for any non-deterministic provider; do not set it
# together with LLM_API_KEY.
LLM_API_KEY_FILE=
LLM_CHAT_MODEL=deterministic-demo-v1
LLM_EMBEDDING_MODEL=deterministic-hash-v1
EMBEDDING_DIMENSION=64
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_RESPONSE_BYTES=4194304
RELATIONSHIP_MINIMUM_CONFIDENCE=0.55

# Content-free Rust OTLP export. Staging/production require an endpoint and
# JSON logs. Plaintext there is accepted only for an in-cluster
# `*-otel-collector:4317` service; use HTTPS for external collectors.
OTEL_SERVICE_NAME=pakperk-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_EXPORT_TIMEOUT_SECONDS=5
OTEL_METRIC_EXPORT_INTERVAL_SECONDS=30
OTEL_TRACES_SAMPLER_ARG=1.0
# Mobile diagnostics terminate at the public gateway; it forwards only the
# closed, content-free schema to this exact private OTLP/HTTP logs endpoint.
TELEMETRY_GATEWAY_BIND=0.0.0.0:8080
MOBILE_TELEMETRY_UPSTREAM_URL=http://pakperk-otel-collector:4318/v1/logs

DEMO_MODE=true
DEMO_SEED_MANIFEST=/app/demo/seed_manifest.json
DEMO_FALLBACK_FEED=/app/demo/fallback_feed.json

# Worker lease and polling controls.
JOB_POLL_INTERVAL_MS=1000
JOB_LEASE_SECONDS=300

# Anonymous abuse controls. The API enforces both trusted-origin and optional
# anonymous-session buckets through shared PostgreSQL state across replicas.
PREPARE_REQUESTS_PER_MINUTE=6
CHAT_REQUESTS_PER_MINUTE=30

# Host-only Compose conveniences. They are not read by the Rust services.
API_PORT=8080
POSTGRES_PORT=5432
GROBID_PORT=8070
KEYCLOAK_PORT=8081
KEYCLOAK_MANAGEMENT_PORT=9001
MAILPIT_UI_PORT=8025
# Development-only defaults. Production injects Keycloak database/bootstrap
# credentials from a secret manager rather than this file.
KEYCLOAK_DATABASE_PASSWORD=pakperk-keycloak-dev
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=pakperk-admin-dev
