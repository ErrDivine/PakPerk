APP_ENV=development
API_BIND=0.0.0.0:8080
DATABASE_URL=postgres://pakperk:pakperk@postgres:5432/pakperk
DATABASE_POOL_SIZE=10
RUN_MIGRATIONS=true
RUST_LOG=pakperk=info,tower_http=info
REQUEST_TIMEOUT_SECONDS=30
CHAT_REQUEST_TIMEOUT_SECONDS=65
API_MAX_REQUEST_BYTES=65536
CORS_ALLOWED_ORIGINS=http://localhost:3000

ARXIV_CATEGORIES=cs.AI,cs.CL,cs.LG
ARXIV_BATCH_SIZE=100
ARXIV_MIN_INTERVAL_MS=3000
ARXIV_USER_AGENT=PakperkDemo/0.1
# Required before either Rust process starts. Use a monitored, real address;
# placeholder and example-domain contacts are rejected deliberately.
ARXIV_CONTACT_EMAIL=sun2280221371@gmail.com
ARXIV_REQUEST_TIMEOUT_SECONDS=30
ARXIV_CACHE_TTL_SECONDS=86400
METADATA_SYNC_ON_START=false
METADATA_SYNC_INTERVAL_SECONDS=86400

GROBID_URL=http://grobid:8070
GROBID_TIMEOUT_SECONDS=180
MAX_PDF_BYTES=52428800
# Reserved for a future licensed raw-PDF cache. Current workers always use a
# bounded temporary file and delete it after parsing.
PDF_CACHE_TTL_HOURS=24
FULLTEXT_POLICY=prototype

LLM_PROVIDER=deterministic
LLM_BASE_URL=
LLM_API_KEY=
LLM_CHAT_MODEL=deterministic-demo-v1
LLM_EMBEDDING_MODEL=deterministic-hash-v1
EMBEDDING_DIMENSION=64
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_RESPONSE_BYTES=4194304
RELATIONSHIP_MINIMUM_CONFIDENCE=0.55

DEMO_MODE=true
DEMO_SEED_MANIFEST=/app/demo/seed_manifest.json
DEMO_FALLBACK_FEED=/app/demo/fallback_feed.json

# Worker lease and polling controls.
JOB_POLL_INTERVAL_MS=1000
JOB_LEASE_SECONDS=300

# Anonymous abuse controls. Limits are enforced per process for the demo.
PREPARE_REQUESTS_PER_MINUTE=6
CHAT_REQUESTS_PER_MINUTE=30

# Host-only Compose conveniences. They are not read by the Rust services.
API_PORT=8080
POSTGRES_PORT=5432
GROBID_PORT=8070
