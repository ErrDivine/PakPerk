  </t:teiHeader>
  <t:text>
    <t:body>
      <t:div xml:id="sec-intro">
        <t:head n="1">1 Introduction</t:head>
        <t:p coords="1,10.0,20.0,400.0,80.0">
          This paper builds on <t:ref type="bibr" target="#b0">[1]</t:ref> to study
          robust scientific reading on phones. The remainder explains the design
          and establishes enough substantial introductory context for detection.
        </t:p>
        <t:div xml:id="sec-motivation">
          <t:head n="1.1">1.1 Motivation</t:head>
          <t:p coords="2,10.0,20.0,400.0,80.0">
            Mobile readers need a carefully bounded interaction model with enough
            context to make long scientific documents approachable.
          </t:p>
        </t:div>
      </t:div>
      <t:div xml:id="sec-method">
        <t:head n="2">2 Method</t:head>
        <t:p coords="3,10.0,20.0,400.0,80.0">
          Our method compares against <t:ref type="bibr" target="#b1">[2]</t:ref>.
          It retrieves paragraph-aware evidence and does not trust document text
          as instructions.
        </t:p>
      </t:div>
      <t:div xml:id="sec-related">
        <t:head n="3">Related Work</t:head>
        <t:p coords="4,10.0,20.0,400.0,80.0">Prior work is summarized here.</t:p>
      </t:div>
    </t:body>
